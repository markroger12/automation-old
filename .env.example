# ─────────────────────────────────────────────────────────────
# Blog Automation Studio — environment configuration
#
# You don't need to copy this file by hand: "npm run setup" creates .env
# for you with a random SESSION_SECRET. This file documents the options.
# ─────────────────────────────────────────────────────────────

# Database file (SQLite). The path is relative to the prisma/ folder,
# so this stores the database in ./data/app.db. No database server needed.
DATABASE_URL="file:../data/app.db"

# Secret used to sign dashboard sign-in cookies. Minimum 32 characters.
SESSION_SECRET="generated-by-npm-run-setup"

# Private folder for the database, saved browser logins (cookies) and
# failure screenshots. Never share or publish this folder.
DATA_DIR="./data"

# Which browser Playwright launches:
#   chrome   -> installed Google Chrome (recommended)
#   msedge   -> installed Microsoft Edge
#   chromium -> Playwright's bundled Chromium (run `npm run playwright:install`)
BROWSER_CHANNEL="chrome"

# Optional absolute path to a Chrome/Chromium executable (overrides BROWSER_CHANNEL)
BROWSER_EXECUTABLE_PATH=""

# Set to "true" when the dashboard is served over HTTPS so cookies get the Secure flag
COOKIE_SECURE="false"

# Optional: create the dashboard admin during setup instead of on the first visit.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-10-characters"

# Plagiarism Check: Google results through serper.dev (optional)
SERPER_API_KEY=
