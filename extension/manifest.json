{
  "manifest_version": 3,
  "name": "Blog Automation Studio - ChatGPT Worker",
  "version": "1.6.25",
  "description": "Sends Blog Automation Studio's article prompts to ChatGPT in this Chrome profile and returns the answers to the app.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://images.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.mm.bing.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Blog Automation Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
