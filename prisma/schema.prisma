// Blog Automation Studio — database schema (SQLite: a single file, no database server needed)
// All automation happens through browser sessions; no ChatGPT/WordPress
// passwords or API credentials are stored anywhere in this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users ───────────────────────────

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         UserRole      @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        ArticleTask[]
}

// ─────────────────────── Browser profiles ────────────────────

enum ProfileKind {
  CHATGPT
  WORDPRESS
  GENERIC
}

enum SessionStatus {
  UNKNOWN
  ACTIVE
  LOGIN_REQUIRED
  ERROR
}

model BrowserProfile {
  id            String        @id @default(cuid())
  name          String
  kind          ProfileKind
  /// Directory name (not a path) inside DATA_DIR/profiles
  directory     String        @unique
  sessionStatus SessionStatus @default(UNKNOWN)
  sessionDetail String?
  lastCheckedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  websites      Website[]
}

// ─────────────────────────── Websites ────────────────────────

enum EditorType {
  AUTO
  GUTENBERG
  CLASSIC
}

model Website {
  id                    String          @id @default(cuid())
  name                  String
  url                   String
  adminUrl              String
  profileId             String?
  profile               BrowserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  defaultCategoryId     String?
  defaultAuthor         String?
  editorType            EditorType      @default(AUTO)
  isActive              Boolean         @default(true)
  /// Images for this website's celebrity articles and for its Tigram articles, switched on or off separately.
  celebrityImages       Boolean         @default(true)
  tigramImages          Boolean         @default(true)
  /// Image template: the logo file in data/templates, the colour of the line and the corner the logo sits in.
  logoFile              String?
  accentColour          String?
  logoPosition          String?
  /// Featured image: "split" = two pictures with the line and the logo between them, "single" = one picture.
  featuredStyle         String?
  /// The design made in the Image Template editor: { featured: {...}, body: {...} }.
  imageTemplate         Json?
  /// Off: the automation only ever saves drafts for this website (the publish guard stays closed).
  canPublish            Boolean         @default(false)
  /// The time zone WordPress itself uses, e.g. "Europe/Berlin" — a scheduled post is entered in that zone.
  siteTimezone          String?
  /// The property in Google Search Console, e.g. "https://example.com/" or "sc-domain:example.com".
  searchConsoleProperty String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  categories            Category[]
  tasks                 ArticleTask[]
  workflow              Workflow?
}

model Category {
  id        String        @id @default(cuid())
  websiteId String
  website   Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime      @default(now())
  tasks     ArticleTask[]

  @@unique([websiteId, name])
}

// ───────────────────────── Article tasks ─────────────────────

enum TaskStatus {
  QUEUED
  OPENING_CHATGPT
  GENERATING_TITLES
  AWAITING_TITLE_APPROVAL
  RESEARCHING
  WRITING_ARTICLE
  OPTIMIZING
  GENERATING_FAQS
  GENERATING_BIO_TABLE
  SEO_CHECKING
  AWAITING_ARTICLE_APPROVAL
  OPENING_WORDPRESS
  CREATING_DRAFT
  RUNNING_RANKMATH
  DRAFT_CREATED
  NEEDS_REVIEW
  LOGIN_REQUIRED
  FAILED
  CANCELLED
}

model ArticleTask {
  id                String    @id @default(cuid())
  moduleKey         String    @default("celebrity-writer")
  keyword           String
  exampleTitle      String?
  secondaryKeywords Json      @default("[]")
  targetCountry     String?
  language          String?
  websiteId         String?
  website           Website?  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Snapshot of the category name used for WordPress selection
  categoryName      String?
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  status           TaskStatus @default(QUEUED)
  currentStage     String?
  progress         Int        @default(0)
  statusMessage    String?
  reviewReasons    Json       @default("[]")
  /// "chatgpt" | "wordpress" when status = LOGIN_REQUIRED
  loginRequiredFor String?
  error            String?
  cancelRequested  Boolean    @default(false)

  titleOptions      Json      @default("[]")
  recommendedTitle  String?
  selectedTitle     String?
  titleApprovedAt   DateTime?
  articleApprovedAt DateTime?

  /// Final optimized article (intro + sections + conclusion), sanitized HTML
  bodyHtml        String?
  /// Fully assembled article sent to WordPress
  contentHtml     String?
  faqs            Json?
  quickBio        Json?
  seoTitle        String?
  metaDescription String?
  slug            String?
  focusKeyword    String?
  tags            Json    @default("[]")

  wordCount      Int?
  keywordCount   Int?
  keywordDensity Float?
  h2Count        Int?
  h3Count        Int?
  seoScore       Int?
  rankMathScore  Int?

  chatgptConversationUrl String?
  wpPostId               String?
  wpEditUrl              String?
  wpDraftSavedAt         DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stages           ArticleStage[]
  responses        ChatGPTResponse[]
  seoReports       SEOReport[]
  logs             Log[]
  workflowKeywords WorkflowKeyword[]

  @@index([status])
  @@index([createdAt])
  @@index([moduleKey])
  @@index([websiteId])
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model ArticleStage {
  id          String      @id @default(cuid())
  taskId      String
  task        ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int
  status      StageStatus @default(PENDING)
  attempts    Int         @default(0)
  prompt      String?
  output      String?
  outputHtml  String?
  data        Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([taskId, key])
  @@index([taskId])
}

model ChatGPTResponse {
  id              String      @id @default(cuid())
  taskId          String
  task            ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stageKey        String
  attempt         Int         @default(1)
  prompt          String
  responseText    String
  responseHtml    String?
  conversationUrl String?
  /// true when an already-generated answer was recovered instead of re-sending the prompt
  reusedExisting  Boolean     @default(false)
  durationMs      Int?
  createdAt       DateTime    @default(now())

  @@index([taskId, stageKey])
}

// ─────────────────────────── Prompts ─────────────────────────

model PromptTemplate {
  id          String   @id @default(cuid())
  moduleKey   String
  key         String
  name        String
  description String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleKey, key])
}

// ─────────────────────────── Settings ────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ──────────────────────────── Logs ───────────────────────────

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model Log {
  id             String       @id @default(cuid())
  taskId         String?
  task           ArticleTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level          LogLevel     @default(INFO)
  /// SYSTEM | BROWSER | CHATGPT | WORDPRESS | RANKMATH | SEO | QUEUE | SESSION
  category       String
  stage          String?
  message        String
  data           Json?
  screenshotPath String?
  createdAt      DateTime     @default(now())

  @@index([taskId])
  @@index([createdAt])
  @@index([level])
}

// ──────────────────────── Built-in job queue ────────────────────────
// Replaces Redis/BullMQ: the worker process claims jobs from this table.

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

model QueueJob {
  id          String    @id @default(cuid())
  /// "article" (article workflow runs) or "control" (browser session actions)
  queue       String
  name        String
  /// Article task the job belongs to (article queue only)
  taskId      String?
  data        Json
  status      JobStatus @default(WAITING)
  result      Json?
  error       String?
  attempts    Int       @default(0)
  lockedBy    String?
  heartbeatAt DateTime?
  /// A job with a time is only picked up once that moment has passed (the workflow writes ahead of time).
  runAt       DateTime?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([queue, status, createdAt])
  @@index([taskId, status])
}

/// Last heartbeat of the automation worker, so the dashboard can tell whether it is running.
model WorkerStatus {
  id         String   @id
  lastSeenAt DateTime
  info       Json?
}

// ───────────────────────── SEO reports ───────────────────────

enum SeoReportSource {
  INTERNAL
  RANKMATH
}

model SEOReport {
  id        String          @id @default(cuid())
  taskId    String
  task      ArticleTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  source    SeoReportSource
  score     Int?
  checks    Json
  metrics   Json?
  createdAt DateTime        @default(now())

  @@index([taskId])
}

// ───────────────────────── Workflow ──────────────────────────
// One workflow per website: a list of keywords, the times its articles are published, and what happens after.

/// Which writer a keyword belongs to. UNKNOWN = not looked at yet.
enum KeywordKind {
  UNKNOWN
  CELEBRITY
  TIGRAM
}

/// Where a keyword is on its way from the list to a published, indexed article.
enum KeywordState {
  WAITING
  WRITING
  READY
  SCHEDULED
  PUBLISHED
  INDEXED
  FAILED
  SKIPPED
  DONE
}

model Workflow {
  id                String            @id @default(cuid())
  websiteId         String            @unique
  website           Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  isActive          Boolean           @default(false)
  /// Publish times in Pakistan time, 24 hours: ["04:00", "04:30", ...]. One article per time.
  publishTimes      Json              @default("[]")
  /// Days of the week it runs, 0 = Sunday. Empty = every day.
  days              Json              @default("[]")
  /// How many hours before its publish time an article starts being written.
  writeAheadHours   Int               @default(12)
  /// Images for the articles of this workflow: null = follow the website's own switches.
  images            Boolean?
  /// Ask Google Search Console to index the article once it is live.
  indexAfterPublish Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  keywords          WorkflowKeyword[]
}

model WorkflowKeyword {
  id                String       @id @default(cuid())
  workflowId        String
  workflow          Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  keyword           String
  /// An example title for this article; empty lets the writer make its own.
  title             String?
  secondaryKeywords Json         @default("[]")
  kind              KeywordKind  @default(UNKNOWN)
  /// How the kind was decided: "wikidata", "chatgpt" or "manual".
  kindSource        String?
  /// What the detection found, for the user to see (e.g. "American actress").
  kindNote          String?
  state             KeywordState @default(WAITING)
  /// The article written for this keyword.
  taskId            String?
  task              ArticleTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// The moment it should go live, in real time (stored as UTC).
  publishAt         DateTime?
  publishedUrl      String?
  publishedAt       DateTime?
  indexedAt         DateTime?
  /// Why it could not be written, published or indexed.
  lastError         String?
  attempts          Int          @default(0)
  /// The order in the list; the smallest number is written first.
  position          Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workflowId, state])
  @@index([publishAt])
}
